
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Property - Airbnb</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f7f7f7;
            color: #222;
        }

        nav {
            background: white;
            padding: 18px 6%;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

        .logo {
            color: #ff385c;
            font-size: 27px;
            font-weight: bold;
            text-decoration: none;
        }

        .container {
            max-width: 650px;
            margin: 40px auto;
            padding: 20px;
        }

        .form-card {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 3px 15px rgba(0,0,0,0.08);
        }

        h1 {
            text-align: center;
            margin-bottom: 25px;
        }

        label {
            display: block;
            font-weight: bold;
            margin-top: 18px;
            margin-bottom: 8px;
        }

        input, textarea {
            width: 100%;
            padding: 13px;
            border: 1px solid #ccc;
            border-radius: 8px;
            font-size: 15px;
        }

        textarea {
            min-height: 110px;
            resize: vertical;
        }

        button {
            width: 100%;
            margin-top: 25px;
            padding: 14px;
            background: #ff385c;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
        }

        button:hover {
            background: #e31c5f;
        }

        .back {
            display: block;
            text-align: center;
            margin-top: 18px;
            color: #ff385c;
            text-decoration: none;
        }
    </style>
</head>

<body>

    <nav>
        <a href="/" class="logo">airbnb</a>
    </nav>

    <div class="container">

        <div class="form-card">

            <h1>Edit Your Property</h1>

            <form action="/listings/<%= listing._id %>/edit" method="POST">

                <label>Property Name</label>
                <input
                    type="text"
                    name="title"
                    value="<%= listing.title %>"
                    required
                >

                <label>Description</label>
                <textarea
                    name="description"
                    required
                ><%= listing.description %></textarea>

                <label>Image URL</label>
                <input
                    type="url"
                    name="image"
                    value="<%= listing.image %>"
                    required
                >

                <label>Price Per Night (₹)</label>
                <input
                    type="number"
                    name="price"
                    value="<%= listing.price %>"
                    min="1"
                    required
                >

                <label>Location</label>
                <input
                    type="text"
                    name="location"
                    value="<%= listing.location %>"
                    required
                >

                <label>Country</label>
                <input
                    type="text"
                    name="country"
                    value="<%= listing.country %>"
                    required
                >

                <button type="submit">Update Property</button>

            </form>

            <a href="/listings/<%= listing._id %>" class="back">
                Back to Property
            </a>

        </div>

    </div>

</body>
</html>
