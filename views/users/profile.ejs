
<%- layout("/layouts/boilerplate") %>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-4 p-md-5 text-center">

                    <div class="mb-4">
                        <div class="rounded-circle bg-dark text-white d-inline-flex align-items-center justify-content-center"
                             style="width:100px;height:100px;font-size:40px;">
                            <i class="fa-solid fa-user"></i>
                        </div>
                    </div>

                    <h2 class="mb-2">My Profile</h2>
                    <p class="text-muted mb-4">
                        Welcome to your Airbnb account!
                    </p>

                    <div class="text-start">

                        <div class="border rounded-3 p-3 mb-3">
                            <small class="text-muted">Username</small>
                            <h5 class="mb-0">
                                <%= currentUser.username %>
                            </h5>
                        </div>

                        <div class="border rounded-3 p-3 mb-3">
                            <small class="text-muted">Account ID</small>
                            <p class="mb-0 text-break">
                                <%= currentUser._id %>
                            </p>
                        </div>

                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <a href="/my-bookings" class="btn btn-dark">
                            <i class="fa-solid fa-calendar-check me-2"></i>
                            My Bookings
                        </a>

                        <a href="/listings" class="btn btn-outline-dark">
                            Explore Properties
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
